{
  "$comment": "Subset of JSON Schema that scripts/validate_manifest.py understands: type, required, properties, additionalProperties, enum, items, minItems, minLength, pattern, const.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "skill_id", "name", "version", "record_type", "evidence_level",
    "origin", "goal", "applicability", "inputs", "outputs", "mechanism", "procedure",
    "dependencies", "conflicts", "refs", "task_contracts", "curiosity", "lineage",
    "integrity", "access"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "record_type": {"enum": ["research-procedure", "recipe", "diagnostic", "boundary"]},
    "evidence_level": {"enum": ["observed", "inferred", "predicted"]},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_id", "created_at"],
      "properties": {
        "goal_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1}
      }
    },
    "goal": {"type": "string", "minLength": 1},
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["triggers", "known_counterexamples"],
      "properties": {
        "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "known_counterexamples": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mechanism": {"type": "string", "minLength": 1},
    "procedure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skill_id", "version"],
        "properties": {
          "skill_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
        }
      }
    },
    "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "refs": {"type": "array", "items": {"type": "string", "pattern": "^(C|E)-[0-9]+$"}},
    "task_contracts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "command", "expected_exit", "expected_stdout"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-[0-9]+$"},
          "command": {"type": "string", "minLength": 1},
          "expected_exit": {"type": "integer"},
          "expected_stdout": {"type": "string"},
          "fixture": {"type": "string", "minLength": 1},
          "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "timeout_seconds": {"type": "integer"}
        }
      }
    },
    "curiosity": {
      "type": "object", "additionalProperties": false,
      "required": ["spark_ids", "boundary"],
      "properties": {
        "spark_ids": {"type": "array", "items": {"type": "string", "pattern": "^SP-[0-9]+$"}},
        "boundary": {"type": ["string", "null"]}
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["parent", "reason"],
      "properties": {
        "parent": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["skill_id", "version"],
          "properties": {
            "skill_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "reason": {"type": "string"}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {"type": "object"}
      }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["scope"],
      "properties": {"scope": {"enum": ["public", "private"]}}
    }
  }
}
