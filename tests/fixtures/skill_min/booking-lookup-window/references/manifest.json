  "goal": "Tell whether the lookup tool was reachable inside a time window of a call export.",
  "applicability": {
    "triggers": [
      "bookings failing",
      "call volume normal",
      "lookup tool silent",
      "call export"
    ],
    "known_counterexamples": [
      "Calls routed to a different assistant also show zero attempts."
    ]
  },
  "inputs": [
    "call export as JSON with start_utc and tool_calls per call",
    "UTC window start and end"
  ],
  "outputs": [
    "OK, SILENT or EMPTY line with call and attempt counts"
  ],
  "mechanism": "Zero lookup attempts while calls continue means the tool was not offered to the model, which points at configuration rather than callers.",
  "procedure": [
    "Export the calls for the day as JSON.",
    "Run scripts/check_window.py with the export and the window.",
    "Read OK, SILENT or EMPTY."
  ],
